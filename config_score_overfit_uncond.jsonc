{
  // Unconditional prior sanity test: ~32 dense Ha maps, no imaging/spectrum cond.
  // python runner_score_overfit.py --config config_score_overfit_uncond.jsonc --run-name score_overfit_uncond --autoinc
  "training": {
    "device": "cuda:1",
    "seed": 42,
    "epochs": 400,
    "mixed_precision": false,
    "grad_clip": 1.0,
    "optimizer": { "lr": 0.0002, "weight_decay": 0.0 },
    "lr_schedule": { "name": "warmup_cosine", "warmup_epochs": 10, "min_lr_ratio": 0.01 },
    "batching": { "train_batch_size": 4, "eval_batch_size": 4, "num_workers": 2 },
    "early_stopping": { "patience": 200, "start_epoch": 50 },
    "logging": {
      "root_dir": "runs/score_overfit",
      "save_every_epochs": 50,
      "write_plots": true,
      "write_csv_history": true,
      "save_config_snapshot": true,
      "eval_max_plot": 8,
      "eval_splits": ["train"],
      "run_post_train_eval": true
    }
  },

  "data": {
    "data_root": "manga_sdss_fits",
    "use_sdss": true,
    "use_legacy": false,
    "use_spectrum": false,
    "use_footprint_mask": true,
    "imaging_resolution": "aligned",
    "spectrum_mode": "fake",
    "spectrum_fallback": true,
    "require_all": true,
    "augmentation": { "enabled": true, "hflip": true, "vflip": true, "rot90": true, "p": 0.5 },
    "split": {
      "split_csv_path": "manga_sdss_fits/splits/default_split.csv",
      "seed": 42,
      "train_frac": 0.8,
      "val_frac": 0.1,
      "test_frac": 0.1
    }
  },

  "score": {
    "mode": "generator",
    "unconditional": true,
    "condition_on_label_mask": false,
    "n_galaxies": 32,
    "coverage_csv": "runs/dataset_audit/galaxy_coverage_meta.csv",
    "min_coverage_pct": 99.0,
    "feature": "ha_flux",
    "use_stratified_weights": false,
    "base_run_dir": "runs/arch_ablation/arch_v1/runs/A_unet",
    "base_checkpoint": "best.pt",
    "channel_key": "ha_flux",
    "diffusion_steps": 1000,
    "ddim_steps": 50,
    "n_samples": 4,
    "eval_t_start_fracs": [1.0],
    "base_channels": 64,
    "channel_mults": [1, 2, 4, 4],
    "num_res_blocks": 2,
    "schedule": "cosine",
    "ema_decay": 0.999,
    "use_min_snr": true,
    "min_snr_gamma": 5.0,
    "use_bottleneck_attn": true,
    "attn_heads": 4
  },

  "model": {
    "architecture": "unet",
    "output_head": "single",
    "target_keys": ["ha_flux"],
    "imaging_resolution": "aligned",
    "spatial_pipeline": "symmetric",
    "footprint_mode": "loss_only",
    "target_spatial_size": 76,
    "use_hr_cross_attention": false,
    "use_spectrum": false,
    "input_norm": {
      "mode": "asinh",
      "scales_path": "manga_sdss_fits/stats/input_asinh_scales.json",
      "auto_compute": true,
      "imaging_percentile": 99,
      "spectrum_percentile": 99
    },
    "losses": ["l1"],
    "loss_weights": [1.0]
  }
}
