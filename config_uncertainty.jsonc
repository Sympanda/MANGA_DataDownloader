{
  // Uncertainty (heteroscedastic μ+σ) map model — separate from config.jsonc baseline runs.
  // Run:  python runner_uncertainty.py --config config_uncertainty.jsonc --run-name unc_v1 --autoinc
  // Ens:  python runner_ensemble.py --config config_uncertainty.jsonc --ensemble-name ens_v1 --n-models 5

  "training": {
    "device": "cuda:1",
    "seed": 42,
    "epochs": 200,
    "mixed_precision": true,
    "grad_clip": 1.0,

    "optimizer": {
      "lr": 3e-4,
      "weight_decay": 1e-4
    },

    "lr_schedule": {
      "name": "warmup_cosine",
      "warmup_epochs": 5,
      "min_lr_ratio": 0.005
    },

    "batching": {
      "train_batch_size": 16,
      "eval_batch_size": 32,
      "num_workers": 4
    },

    "early_stopping": {
      "patience": 20,
      "start_epoch": 30
    },

    "logging": {
      "root_dir": "runs/manga_maps",
      "save_every_epochs": 5,
      "write_plots": true,
      "write_csv_history": true,
      "save_config_snapshot": true,
      "eval_max_plot": 32,
      "eval_splits": ["val", "test"],
      "run_post_train_eval": true
    }
  },

  "data": {
    "data_root": "manga_sdss_fits",
    "use_sdss": true,
    "use_legacy": false,
    "use_spectrum": true,
    "use_footprint_mask": true,
    "imaging_resolution": "aligned",
    "spectrum_mode": "fake",
    "spectrum_fallback": true,
    "require_all": true,

    "augmentation": {
      "enabled": true,
      "hflip": true,
      "vflip": true,
      "rot90": true,
      "p": 0.5
    },

    "split": {
      "split_csv_path": "manga_sdss_fits/splits/default_split.csv",
      "seed": 42,
      "train_frac": 0.8,
      "val_frac": 0.1,
      "test_frac": 0.1
    }
  },

  "model": {
    "architecture": "unetpp",
    "output_head": "gaussian",

    "imaging_resolution": "aligned",
    "spatial_pipeline": "symmetric",
    "footprint_mode": "spatial_channel",
    "target_spatial_size": 76,
    "hr_project_mode": "bilinear",

    "imaging_clamp_min": -5.0,
    "imaging_clamp_max": 100.0,

    "base_channels": 64,
    "bottleneck_multiplier": 16,
    "n_down": 4,
    "dropout": 0.05,
    "upsample_mode": "transpose",
    "norm": "gn",
    "residual_blocks": true,

    "cond_dim": 64,
    "film_injection": "encoder",

    "spectrum_pooling": "attention",
    "spectrum_use_wavelength": true,
    "spectrum_use_ivar": true,

    "losses": [
      "gaussian_nll",
      "charbonnier",
      "l1",
      "mse",
      "grad",
      "laplacian",
      "integration",
      "tv_pred",
      "residual_amp",
      "residual_tv"
    ],
    // NLL alone can inflate σ to reduce loss; L1 on μ keeps fidelity (v8-style).
    // Prefer L1 over MSE — MSE is already implicit in NLL when σ is small.
    "loss_weights": [
      1.0,   // gaussian_nll
      0.0,   // charbonnier
      0.4,   // l1 on μ — fidelity anchor
      0.0,   // mse
      0.35,  // grad
      0.15,  // laplacian
      0.0,   // integration
      0.0,   // tv_pred
      0.0,   // residual_amp
      0.0    // residual_tv
    ],
    "loss_params": {
      "gaussian_nll": { "min_log_var": -6.0, "max_log_var": 6.0 },
      "charbonnier": { "eps": 1e-3 },
      "integration": { "normalize": "mean" }
    }
  },

  "ensemble": {
    "base_split_csv": "manga_sdss_fits/splits/default_split.csv",
    "member_seed_offset": 1000,
    "secondary_sigma": "epistemic",
    "eval_max_plot": 32
  }
}
