{
  // Pixel-SED photometric baselines (Hα only). Galaxy-level splits; aligned 76×76 ugriz.
  // Linear:  python runner_pixel.py --config config_pixel.jsonc --variant linear --run-name pix_linear_ha --autoinc
  // MLP:     python runner_pixel.py --config config_pixel.jsonc --variant mlp --run-name pix_mlp_ha --autoinc

  "training": {
    "device": "cuda:0",
    "seed": 42,
    "epochs": 100,
    "mixed_precision": false,
    "grad_clip": 1.0,

    "optimizer": {
      "lr": 1e-3,
      "weight_decay": 1e-4
    },

    "lr_schedule": {
      "name": "warmup_cosine",
      "warmup_epochs": 5,
      "min_lr_ratio": 0.01
    },

    "batching": {
      "train_batch_size": 32,
      "eval_batch_size": 64,
      "num_workers": 4
    },

    "early_stopping": {
      "patience": 20,
      "start_epoch": 10
    },

    "logging": {
      "root_dir": "runs/pixel_sed",
      "save_every_epochs": 5,
      "write_plots": true,
      "write_csv_history": true,
      "save_config_snapshot": true,
      "eval_max_plot": 8,
      "eval_splits": ["val", "test"],
      "run_post_train_eval": true
    }
  },

  "data": {
    "data_root": "manga_sdss_fits",
    "use_sdss": true,
    "use_legacy": false,
    // Pixel models do not consume spectrum / footprint as features.
    "use_spectrum": false,
    "use_footprint_mask": true,
    "imaging_resolution": "aligned",
    "spectrum_mode": "fake",
    "spectrum_fallback": true,
    "require_all": true,

    "augmentation": {
      "enabled": true,
      "hflip": true,
      "vflip": true,
      "rot90": true,
      "p": 0.5
    },

    "split": {
      "split_csv_path": "manga_sdss_fits/splits/default_split.csv",
      "seed": 42,
      "train_frac": 0.8,
      "val_frac": 0.1,
      "test_frac": 0.1
    }
  },

  "model": {
    // Pixel SED — not a UNet; architecture fields below satisfy ModelConfig builders only.
    "variant": "mlp",
    "hidden_channels": 32,
    "architecture": "unet",
    "output_head": "single",
    "target_keys": ["ha_flux"],

    "imaging_resolution": "aligned",
    "spatial_pipeline": "symmetric",
    "footprint_mode": "loss_only",
    "target_spatial_size": 76,
    "use_hr_cross_attention": false,
    "use_spectrum": false,

    "imaging_clamp_min": null,
    "imaging_clamp_max": null,

    "input_norm": {
      "mode": "asinh",
      "scales_path": "manga_sdss_fits/stats/input_asinh_scales.json",
      "auto_compute": true,
      "imaging_percentile": 99,
      "spectrum_percentile": 99
    },

    // Dummy UNet fields (unused by PixelMapGenerator).
    "base_channels": 32,
    "bottleneck_multiplier": 8,
    "n_down": 2,
    "dropout": 0.0,
    "upsample_mode": "bilinear",
    "norm": "gn",
    "residual_blocks": false,
    "cond_dim": 16,
    "film_injection": "none",
    "deep_supervision": false,

    "losses": ["l1", "mse", "grad", "laplacian"],
    "loss_weights": [1.0, 0.0, 0.2, 0.1],
    "loss_params": {}
  }
}
