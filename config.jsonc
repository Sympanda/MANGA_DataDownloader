{
  // =============================================================================
  // MaNGA map prediction — master training config (JSONC: // comments allowed)
  // Run:  python runner.py --config config.jsonc --run-name exp_001 --autoinc
  // =============================================================================

  "training": {
    "device": "cuda:1",
    "seed": 42,
    "epochs": 200,
    "mixed_precision": true,
    "grad_clip": 1.0,

    "optimizer": {
      "lr": 1e-3,
      "weight_decay": 1e-4
    },

    "lr_schedule": {
      "name": "warmup_cosine",
      "warmup_epochs": 10,
      "min_lr_ratio": 0.005
    },

    "batching": {
      "train_batch_size": 32,
      "eval_batch_size": 64,
      "num_workers": 4
    },

    "early_stopping": {
      "patience": 25,
      // v8 best val was ~epoch 64; start counting non-improvements after warmup.
      "start_epoch": 40
    },

    "logging": {
      "root_dir": "runs/manga_maps",
      "save_every_epochs": 5,
      "write_plots": true,
      "write_csv_history": true,
      "save_config_snapshot": true,
      "eval_max_plot": 8,
      "eval_splits": ["val", "test"],
      "run_post_train_eval": true
    }
  },

  "data": {
    "data_root": "manga_sdss_fits",
    "use_sdss": true,
    "use_legacy": false,
    "use_spectrum": true,
    "use_footprint_mask": true,

    // v10 baseline: aligned 76×76 (same as v8). Native HR deferred until cutouts are cleaned.
    "imaging_resolution": "aligned",

    "spectrum_mode": "fake",
    "spectrum_fallback": true,
    "require_all": true,

    "augmentation": {
      "enabled": true,
      "hflip": true,
      "vflip": true,
      "rot90": true,
      "p": 0.5
    },

    "split": {
      "split_csv_path": "manga_sdss_fits/splits/default_split.csv",
      "seed": 42,
      "train_frac": 0.8,
      "val_frac": 0.1,
      "test_frac": 0.1
    }
  },

  "model": {
    "architecture": "unetpp",
    "output_head": "single",

    // --- Spatial pipeline (v8 symmetric baseline) ---
    "imaging_resolution": "aligned",
    "spatial_pipeline": "symmetric",
    "footprint_mode": "spatial_channel",
    "target_spatial_size": 76,
    "hr_project_mode": "bilinear",

    "imaging_clamp_min": -5.0,
    "imaging_clamp_max": 100.0,

    "base_channels": 64,
    "bottleneck_multiplier": 16,
    "n_down": 4,
    "dropout": 0.05,
    "upsample_mode": "transpose",
    "norm": "gn",
    "residual_blocks": true,

    "cond_dim": 64,
    "film_injection": "encoder",

    // UNet++ deep supervision (Zhou et al.) — preferred over coarse_fine for fidelity.
    // Aux heads on nested full-res nodes x11…x{L-1}{L-1}; deepest uses the full loss stack.
    "deep_supervision": true,
    // Milder than 1/L…(L-1)/L so aux structure terms don't swamp the deepest head.
    "deep_supervision_weights": [0.2, 0.4, 0.6],
    "deep_supervision_loss": "grad",

    // --- Coarse/fine head (disabled when deep_supervision=true; use output_head="single") ---
    "coarse_factor": 2,
    "detail_scale_init": 1.0,

    // --- Losses (composable; weight 0 = disabled) ---
    // Supervised (mask-only, per-channel masks [B,C,H,W]):
    //   charbonnier, l1, mse  — pixel losses on valid spaxels only
    //   grad                  — horizontal/vertical finite differences on valid neighbour pairs
    //   laplacian             — 3×3 Laplacian where full stencil is valid (use low weight)
    //   integration           — masked spatial-sum consistency on flux map channels
    // Regularisation (no target outside mask):
    //   tv_pred               — weak TV on prediction across valid neighbours
    //   residual_amp          — L1 on coarse/fine residual branch (coarse_fine head only)
    //   residual_tv           — pairwise TV on residual branch (coarse_fine head only)
    // Deep supervision (UNet++): aux loss via deep_supervision_* (grad preferred for sharpness).
    // v11 sharpness: stronger grad/laplacian; DS aux uses grad not L1.
    // Prefer deep_supervision over coarse_fine when architecture=unetpp.
    "losses": [
      "charbonnier",
      "l1",
      "mse",
      "grad",
      "laplacian",
      "integration",
      "tv_pred",
      "residual_amp",
      "residual_tv"
    ],
    "loss_weights": [
      0.0,   // charbonnier
      1.0,   // l1
      0.0,   // mse
      1.0,   // grad   (was 0.4)
      0.4,   // laplacian (was 0.18)
      0.0,   // integration
      0.0,   // tv_pred
      0.0,   // residual_amp
      0.0    // residual_tv
    ],
    "loss_params": {
      "charbonnier": { "eps": 1e-3 },
      "integration": { "normalize": "mean" }
    }
  }
}
