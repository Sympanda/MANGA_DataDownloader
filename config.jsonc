{
  // =============================================================================
  // MaNGA map prediction — master training config (JSONC: // comments allowed)
  // Run:  python runner.py --config config.jsonc --run-name exp_001 --autoinc
  // =============================================================================

  "training": {
    "device": "cuda:1",
    "seed": 42,
    "epochs": 200,
    "mixed_precision": true,
    "grad_clip": 1.0,

    "optimizer": {
      "lr": 1e-3,
      "weight_decay": 1e-4
    },

    "lr_schedule": {
      "name": "warmup_cosine",
      "warmup_epochs": 10,
      "min_lr_ratio": 0.005
    },

    "batching": {
      // Level-0 local HR xattn is VRAM-heavy; keep eval ≤ train.
      "train_batch_size": 16,
      "eval_batch_size": 16,
      "num_workers": 4
    },

    "early_stopping": {
      "patience": 25,
      // v8 best val was ~epoch 64; start counting non-improvements after warmup.
      "start_epoch": 40
    },

    "logging": {
      "root_dir": "runs/manga_maps",
      "save_every_epochs": 5,
      "write_plots": true,
      "write_csv_history": true,
      "save_config_snapshot": true,
      "eval_max_plot": 8,
      "eval_splits": ["val", "test"],
      "run_post_train_eval": true
    }
  },

  "data": {
    "data_root": "manga_sdss_fits",
    "use_sdss": true,
    "use_legacy": false,
    "use_spectrum": true,
    "use_footprint_mask": true,

    // Imaging grid for the UNet++ backbone (always WCS-aligned in the dataloader):
    //   "aligned" → Amara FoV / orientation at 76×76 (sdss_aligned.npz)
    //   "native"  → SDSS plate scale on ~196×196 as the *backbone* (legacy HR pipelines)
    // With use_hr_cross_attn, backbone is forced to "aligned"; HR uses sdss_aligned_native.npz.
    // Pre-export for speed (both grids when using HR cross-attn):
    //   python -m manga_prep export-aligned-imaging --config config.jsonc --survey sdss --skip-existing --workers 8
    //   python -m manga_prep export-aligned-imaging --config config.jsonc --survey sdss --grid sdss_native --skip-existing --workers 8
    "imaging_resolution": "aligned",

    "spectrum_mode": "fake",
    "spectrum_fallback": true,
    "require_all": true,

    "augmentation": {
      "enabled": true,
      "hflip": true,
      "vflip": true,
      "rot90": true,
      "p": 0.5
    },

    "split": {
      "split_csv_path": "manga_sdss_fits/splits/default_split.csv",
      "seed": 42,
      "train_frac": 0.8,
      "val_frac": 0.1,
      "test_frac": 0.1
    }
  },

  "model": {
    "architecture": "unetpp",
    "output_head": "single",

    // --- Spatial pipeline ---
    // Backbone: aligned 76×76 ugriz → UNet++ → 76×76 maps
    // Spectrum: FiLM (global)
    // HR: optional cross-attention morphology stream (not resize+concat)
    "imaging_resolution": "aligned",
    "spatial_pipeline": "symmetric",
    "footprint_mode": "spatial_channel",
    "target_spatial_size": 76,
    "hr_project_mode": "bilinear",

    // High-res morphology via local cross-attention (ablation: set false).
    // Accepts aliases: use_hr_cross_attn / hr_cross_attn_levels.
    // Levels 0+1 (76×76 and 38×38) with local 7×7 windows (proj-before-gather).
    "use_hr_cross_attention": true,
    "hr_survey": "sdss",
    "hr_cross_attention_levels": [0, 1],
    "hr_attention_mode": "local",
    "hr_attention_window": 7,
    // Shallower HR encoder keeps high-frequency morphology (1 down ≈ stem + 98px).
    "hr_encoder_n_down": 1,
    "hr_attn_heads": 4,
    "hr_attn_dropout": 0.0,

    // Raw flux clamp (legacy). Prefer null when using asinh input_norm.
    "imaging_clamp_min": null,
    "imaging_clamp_max": null,

    // Soft-normalize imaging + spectrum: asinh(f / s_b).
    // If scales_path is missing, runner auto-computes it on the train split
    // (set auto_compute: false to require a pre-built file).
    // Pick percentile: 95 | 99 | 99.5 (alias 995).
    "input_norm": {
      "mode": "asinh",
      "scales_path": "manga_sdss_fits/stats/input_asinh_scales.json",
      "auto_compute": true,
      "imaging_percentile": 99,
      "spectrum_percentile": 99
    },

    "base_channels": 64,
    "bottleneck_multiplier": 16,
    "n_down": 4,
    "dropout": 0.0,
    "upsample_mode": "transpose",
    "norm": "gn",
    "residual_blocks": true,

    "cond_dim": 64,
    "film_injection": "encoder",

    // --- Spectrum encoder (Task 3) ---
    // pooling: "attention" (keep wavelength structure) | "avg" (legacy global pool)
    "spectrum_pooling": "attention",
    "spectrum_use_wavelength": true,
    "spectrum_use_ivar": true,
    "spectrum_wave_min": 3622.0,
    "spectrum_wave_max": 10354.0,

    // UNet++ deep supervision (Zhou et al.) — preferred over coarse_fine for fidelity.
    // Aux heads on nested full-res nodes X^{0,1}…X^{0,L-1}; deepest uses the full loss stack.
    "deep_supervision": true,
    // null → linear ramp (1/L … (L-1)/L) for the L-1 auxiliary heads
    "deep_supervision_weights": [0.05, 0.10, 0.15],
    "deep_supervision_loss": "l1",

    // --- Spatial pipeline notes ---
    // symmetric + aligned  = 76×76 Amara-aligned backbone (Model B/C)
    // use_hr_cross_attention = HR morphology as K/V tokens → cross-attn into shallow UNet levels
    //   requires: imaging_resolution "aligned", spatial_pipeline "symmetric"
    //   HR loaded separately (sdss_native or Legacy); not resized onto the UNet grid
    // hr_multiscale+native = legacy concat-fuse path (kept for ablation / old runs)
    // hr_encoder / hr_full = legacy single-bottleneck / full-res paths

    // --- Coarse/fine head (disabled when deep_supervision=true; use output_head="single") ---
    "coarse_factor": 2,
    "detail_scale_init": 1.0,

    // --- Losses (composable; weight 0 = disabled) ---
    // Supervised (mask-only, per-channel masks [B,C,H,W]):
    //   charbonnier, l1, mse  — pixel losses on valid spaxels only
    //   grad                  — horizontal/vertical finite differences on valid neighbour pairs
    //   laplacian             — 3×3 Laplacian where full stencil is valid (use low weight)
    //   integration           — masked spatial-sum consistency on flux map channels
    // Regularisation (no target outside mask):
    //   tv_pred               — weak TV on prediction across valid neighbours
    //   residual_amp          — L1 on coarse/fine residual branch (coarse_fine head only)
    //   residual_tv           — pairwise TV on residual branch (coarse_fine head only)
    // Pixel/grad/laplacian reductions are per-(galaxy, map), then mean over active maps.
    // Model B baseline: fixed UNet++ + balanced losses (revert sharp v11 weights).
    "losses": [
      "charbonnier",
      "l1",
      "mse",
      "grad",
      "laplacian",
      "integration",
      "tv_pred",
      "residual_amp",
      "residual_tv"
    ],
    "loss_weights": [
      0.0,   // charbonnier
      1.0,   // l1
      0.0,   // mse
      0.4,   // grad
      0.18,  // laplacian
      0.0,   // integration
      0.0,   // tv_pred
      0.0,   // residual_amp
      0.0    // residual_tv
    ],
    "loss_params": {
      "charbonnier": { "eps": 1e-3 },
      "integration": { "normalize": "mean" }
    }
  }
}
