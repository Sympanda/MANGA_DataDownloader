{
  // Conditional residual diffusion (all 6 Amara maps). Train after deterministic / Gaussian residuals work.
  // python runner_residual_diffusion.py --config config_residual_diffusion_all.jsonc --run-name res_diff_all --autoinc

  "training": {
    "device": "cuda:0",
    "seed": 42,
    "epochs": 120,
    "mixed_precision": false,
    "grad_clip": 1.0,

    "optimizer": {
      "lr": 2e-4,
      "weight_decay": 1e-4
    },

    "lr_schedule": {
      "name": "warmup_cosine",
      "warmup_epochs": 5,
      "min_lr_ratio": 0.01
    },

    "batching": {
      "train_batch_size": 8,
      "eval_batch_size": 8,
      "num_workers": 4
    },

    "early_stopping": {
      "patience": 20,
      "start_epoch": 20
    },

    "logging": {
      "root_dir": "runs/residual_diffusion",
      "save_every_epochs": 5,
      "write_plots": true,
      "write_csv_history": true,
      "save_config_snapshot": true,
      "eval_max_plot": 4,
      "eval_splits": ["val", "test"],
      "run_post_train_eval": true
    }
  },

  "data": {
    "data_root": "manga_sdss_fits",
    "use_sdss": true,
    "use_legacy": false,
    "use_spectrum": false,
    "use_footprint_mask": true,
    "imaging_resolution": "aligned",
    "spectrum_mode": "fake",
    "spectrum_fallback": true,
    "require_all": true,

    "augmentation": {
      "enabled": true,
      "hflip": true,
      "vflip": true,
      "rot90": true,
      "p": 0.5
    },

    "split": {
      "split_csv_path": "manga_sdss_fits/splits/default_split.csv",
      "seed": 42,
      "train_frac": 0.8,
      "val_frac": 0.1,
      "test_frac": 0.1
    }
  },

  "residual": {
    "base_run_dir": "runs/arch_ablation/arch_v1/runs/A_unet",
    "base_checkpoint": "best.pt",
    "channel_key": null
  },

  "diffusion": {
    "diffusion_steps": 1000,
    "ddim_steps": 50,
    "n_samples": 32,
    "base_channels": 32,
    "channel_mults": [1, 2, 4],
    "schedule": "linear",
    "use_footprint_cond": true
  },

  "model": {
    "architecture": "unet",
    "output_head": "single",
    "target_keys": [
      "ha_flux",
      "hbeta_flux",
      "oiii_5007_flux",
      "nii_6584_flux",
      "ha_ew",
      "stellar_av"
    ],

    "imaging_resolution": "aligned",
    "spatial_pipeline": "symmetric",
    "footprint_mode": "loss_only",
    "target_spatial_size": 76,
    "use_hr_cross_attention": false,

    "imaging_clamp_min": null,
    "imaging_clamp_max": null,

    "input_norm": {
      "mode": "asinh",
      "scales_path": "manga_sdss_fits/stats/input_asinh_scales.json",
      "auto_compute": true,
      "imaging_percentile": 99,
      "spectrum_percentile": 99
    },

    "base_channels": 32,
    "bottleneck_multiplier": 8,
    "n_down": 2,
    "dropout": 0.0,
    "upsample_mode": "bilinear",
    "norm": "gn",
    "residual_blocks": false,
    "cond_dim": 16,
    "film_injection": "none",
    "deep_supervision": false,

    // Wrapper trains on diffusion MSE; these satisfy ModelConfig.validate().
    "losses": ["mse"],
    "loss_weights": [1.0],
    "loss_params": {}
  }
}
